# =============================================================================
# SmartRecipe / Dietrix — переменные окружения для docker-compose.
# Скопируйте этот файл в .env и при необходимости отредактируйте значения.
# =============================================================================

# ---- База данных -----------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=med_diet_db

# Порт, по которому Postgres будет доступен с хоста (для pgAdmin и пр.)
DB_EXTERNAL_PORT=5432

# ---- Flask / JWT -----------------------------------------------------------
# ВАЖНО: для production обязательно замените на длинную случайную строку.
# Пример генерации: openssl rand -hex 32
JWT_SECRET_KEY=super-secret-key

# ---- Frontend --------------------------------------------------------------
# Порт, по которому открывается фронт (http://localhost:<FRONTEND_PORT>).
FRONTEND_PORT=8080

# Порт backend наружу.
BACKEND_EXTERNAL_PORT=5000
