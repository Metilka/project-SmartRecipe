{
  "name": "dietrix-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Dietrix desktop shell",
  "author": "Dietrix",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:nsis": "electron-builder --win nsis",
    "dist:prepackaged": "electron-builder --win nsis --prepackaged dist/win-unpacked"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.smartrecipe.dietrix",
    "productName": "Dietrix",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend"
      },
      {
        "from": "../backend/dist/smartrecipe-api",
        "to": "backend"
      },
      {
        "from": "../database/seed.sql",
        "to": "database/seed.sql"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "runtime/postgres",
        "to": "postgres"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dietrix"
    }
  }
}
